{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:web": "node scripts/build_web.mjs",
    "typecheck:web": "tsc --project tsconfig.web.json --noEmit",
    "test:web": "vitest run internal/web/static_src",
    "test:e2e": "npm run lint:e2e && node internal/web/e2e/run.mjs",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "lint:e2e": "node scripts/check_browser_suites.mjs && node --test scripts/check_browser_suites.test.mjs scripts/e2e_performance_selection.test.mjs && eslint --no-error-on-unmatched-pattern internal/web/e2e playwright.config.js",
    "lint:web": "node scripts/lint_web.mjs",
    "lint:web:full": "node scripts/lint_web.mjs --full",
    "check:web-bundles": "node scripts/build_web.mjs --check",
    "test:e2e:pr": "BN_E2E_SUITE=pr npm run test:e2e -- --project=local-chromium-regression --project=hosted-chromium-pr --project=read-only-chromium-regression --project='performance-*'",
    "test:e2e:weekly": "BN_E2E_SUITE=all npm run test:e2e -- --project=local-chromium-regression --project=read-only-chromium-regression --project='hosted-*' --project='performance-*'"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.64.1",
    "cytoscape": "3.33.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.8"
  }
}
