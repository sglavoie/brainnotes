{
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "esbuild internal/web/static_src/main.ts --bundle --format=iife --global-name=BrainNotesApp --outfile=internal/web/static/app.js",
    "typecheck:web": "tsc --project tsconfig.web.json --noEmit",
    "test:web": "vitest run internal/web/static_src",
    "test:e2e": "npm run lint:e2e && node internal/web/e2e/prepare.mjs && playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "lint:e2e": "eslint --no-error-on-unmatched-pattern internal/web/e2e playwright.config.js",
    "lint:web": "node scripts/lint_web.mjs",
    "lint:web:full": "node scripts/lint_web.mjs --full"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@playwright/test": "1.63.0",
    "cytoscape": "3.33.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.8"
  }
}
